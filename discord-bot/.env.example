# Required
DISCORD_BOT_TOKEN=
# URL of your deployed web app (use http://localhost:3000 for local dev)
ZUYCHIN_API_URL=

# The channel the bot converses in (#ask-zuychin). Falls back to
# DISCORD_CHANNEL_ID if unset. Other Discord channels are outbound-only.
DISCORD_ASK_CHANNEL_ID=
# Legacy single channel / fallback.
DISCORD_CHANNEL_ID=

# Comma-separated Discord user IDs the bot answers. Unset answers anyone who can
# post where the bot reads, with the owner's memory, mail and tools.
DISCORD_ALLOWED_USER_IDS=
