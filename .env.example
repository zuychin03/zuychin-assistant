# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key for server-side writes (required in production)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (default chat; optional Gemini Embedding 2 at 768 dimensions)
GEMINI_API_KEY=

# A second key on a free-tier Google project. Lists the same Gemini models
# again as "(free)"; picking one sends the call to this key's quota.
GEMINI_FREE_API_KEY=

# Extra chat/embedding providers (OpenAI-compatible). Set the keys for the
# ones you want to use; providers without a key are hidden in the UI.
# Any of these keys can instead be saved on /admin (Providers and keys); a
# saved key wins over the env var.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# Qualified free Kilo models. Uses the standard gateway API.
KILO_API_KEY=
# Required for the default Nemotron 3 Embed 1B knowledge embeddings (2048d).
NVIDIA_NIM_API_KEY=
# Groq free tier (8K tokens per minute). Its models need a passing test before
# the picker shows them, and Approve before automatic routes use them.
GROQ_API_KEY=
# Agnes AI, $0 at an early-user price with no end date (about 20 requests per
# minute). Models come from discovery and need a passing test, then Approve.
AGNES_API_KEY=
# OpenCode Console, paid credits only (free models answer 403 outside OpenCode).
# Replaces OPENCODE_ZEN_API_KEY. Setup: scripts/OPENCODE_CONSOLE_SETUP.md
OPENCODE_API_KEY=
# Retained but unavailable for the key audited on 23/09/2026.
TOKENROUTER_API_KEY=
# DeepSeek's own API. Bills per token, so it never joins the free worker pool.
DEEPSEEK_API_KEY=

# Dev only: master key for provider keys saved on /admin. 32 random bytes,
# base64 (openssl rand -base64 32). Use a different value from production.
# Production reads it from a systemd credential instead (see README, Provider keys).
# Unset: saving keys is off and the env keys above work as before.
PROVIDER_KEYS_SECRET=
# Only while changing the master key: the old value, so saved keys are re-encrypted.
PROVIDER_KEYS_SECRET_PREVIOUS=

# Optional registered target: nvidia/nemotron-3.5-embed-1b (default, 2048d)
# or gemini-embedding-2 (768d). A saved runtime override takes precedence.
# Plan all five vector tables without writes:
# npx tsx --tsconfig tsconfig.json --env-file=.env.local scripts/reembed-knowledge.ts --model <id> --concurrency 6
# Add --apply for an authorised migration; activation follows complete verification.
KNOWLEDGE_EMBEDDING_MODEL=

# Web search (Tavily). Gives the non-Gemini models real-time internet access via
# the search_web tool. Get a free key at https://tavily.com. Gemini ignores this
# and uses its own Google Search grounding.
#
# Credits meter per account, so a second key on a separate account is a separate
# pool. TAVILY_API_KEY serves quick lookups, TAVILY_API_KEY_DEEP serves thorough
# ones; each borrows the other when its own pool is spent, and Gemini grounding
# covers the case where both are. Both are optional - with neither set, every
# search goes to Gemini. Capture also uses them to read a page the server is
# blocked from or can't reach.
TAVILY_API_KEY=
TAVILY_API_KEY_DEEP=

# Optional. "off" stops Capture fetching links on the server (kill switch).
# CAPTURE_FETCH=off

# Timezone the assistant uses for "today"/"now" and the date/time it sees on every
# request. Any IANA name (e.g. America/New_York). Defaults to Australia/Sydney.
APP_TIMEZONE=

# Access Control
ACCESS_PASSWORD=
# Bearer token for headless callers of /api/chat (the Discord bot). That route
# is outside the browser session, so without this it is reachable by anyone who
# knows the URL - which exposes the RAG store, the model spend and every tool.
# Set the same value here and in the bot's environment.
CHAT_API_KEY=
# Set these in production before enabling passkeys. AUTH_ORIGIN has no trailing slash.
AUTH_SESSION_SECRET=
AUTH_RP_ID=
AUTH_ORIGIN=
AUTH_OWNER_NAME=
AUTH_TOTP_ISSUER=

# Discord - a mostly-outbound life-ops dashboard, one channel per purpose.
# DISCORD_CHANNEL_ID is the legacy single channel and the fallback for any
# DISCORD_CH_* / DISCORD_ASK_CHANNEL_ID left unset. Set the per-purpose ids to
# split notifications into dedicated channels. The Gateway bot only holds
# conversations in DISCORD_ASK_CHANNEL_ID.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ASK_CHANNEL_ID=
DISCORD_CH_BRIEFING=
DISCORD_CH_REMINDERS=
DISCORD_CH_TASKS=
DISCORD_CH_CALENDAR=
DISCORD_CH_BILLS=
DISCORD_CH_COWORKING=
# Opt-in: run-review/system notices stay silent unless this is set.
DISCORD_CH_SYSTEM=

# Telegram - quick conversational chat + occasional improvised nudges
# (initiative). Structured notifications now go to Discord, not here.
TELEGRAM_BOT_TOKEN=
# Your chat. The webhook answers only this chat (plus any in
# TELEGRAM_ALLOWED_CHAT_IDS, comma-separated); production ignores every update
# while neither is set.
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Telegram user ids allowed to act as the owner, comma-separated. A private
# chat's id already names its owner; set this only for a group chat.
TELEGRAM_OWNER_USER_IDS=
# Live testing only: minutes without messages before a Telegram or Discord chat
# starts a new conversation. Leave unset for the 6-hour default.
CHANNEL_QUIET_GAP_MINUTES=

# Google OAuth (Calendar + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cron
CRON_SECRET=
# Optional daily model check (/api/cron/model-discovery). "off" disables it.
# MODEL_DISCOVERY_MAX_PROBES: free models tested per provider per check (0 to 50, default 10).
MODEL_DISCOVERY=
MODEL_DISCOVERY_MAX_PROBES=
# Optional profile lookups inside the daily model check. "off" skips them; the dashboard's Look up still works.
# MODEL_LOOKUP_MAX_PER_RUN: lookups per check (default 4).
MODEL_LOOKUP=
MODEL_LOOKUP_MAX_PER_RUN=

# Web push (PWA notifications). Generate the key pair with:
# npx web-push generate-vapid-keys
# All three are required; any one unset = push disabled. VAPID_SUBJECT is your
# mailto: contact for the push service, e.g. mailto:you@example.com.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: override the voice-reply TTS model
# (default gemini-3.1-flash-tts-preview)
GEMINI_TTS_MODEL=

# Optional on-box speech-to-text (stt-service/), e.g. http://127.0.0.1:3010.
# The token must match the service's STT_TOKEN. Either unset = web voice turns
# send the audio to Gemini as before, and voice stays off in Free only.
STT_SERVICE_URL=
STT_SERVICE_TOKEN=

# Optional on-box text-to-speech (tts-service/), e.g. http://127.0.0.1:3011.
# The token must match the service's TTS_TOKEN. Either unset = replies are
# spoken by Gemini.
TTS_SERVICE_URL=
TTS_SERVICE_TOKEN=

# The address OTHER machines reach this install on, e.g.
# https://zuychin.example. Agent claims are routinely
# minted from localhost but handed to an agent running elsewhere, so they take
# their URL from here rather than from the page that generated them. Unset falls
# back to VERCEL_URL, then the origin in use. Task approval links sent to Telegram
# and Discord use it too, but fall back to AUTH_ORIGIN and then Vercel's
# production domain, never VERCEL_URL.
NEXT_PUBLIC_BASE_URL=

# MCP knowledge access uses named client keys issued through /agents.

# Second Brain vault (private GitHub repo as the online Markdown knowledge base).
# Fine-grained PAT scoped to the single private repo with Contents read/write.
# GITHUB_VAULT_REPO is "owner/repo"; branch defaults to main.
GITHUB_VAULT_TOKEN=
GITHUB_VAULT_REPO=
GITHUB_VAULT_BRANCH=
GITHUB_VAULT_WEBHOOK_SECRET=

# Optional local Obsidian vault name used for obsidian:// open links.
# This is public UI metadata, not a path or secret.
NEXT_PUBLIC_OBSIDIAN_VAULT_NAME=
